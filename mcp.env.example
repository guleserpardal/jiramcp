# Kurum içi Jira MCP sunucusu — OAuth vekili (kişi başına Jira erişimi)
# Bu dosyayı mcp.env adıyla kopyalayıp doldurun. mcp.env repoya KONMAZ.

# --- Jira (Data Center) ---
JIRA_URL=https://cfehjiratest.cignafinans.com.tr
JIRA_SSL_VERIFY=true

# --- OAuth vekili: Jira'daki Application Link (Incoming) kaydının değerleri ---
ATLASSIAN_OAUTH_PROXY_ENABLE=true
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
# Jira kaydındaki Redirect URL ile BİREBİR aynı olmalı
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:9000/callback
ATLASSIAN_OAUTH_SCOPE=READ
PUBLIC_BASE_URL=http://localhost:9000
# Bağlanabilecek istemcilerin dönüş adresleri (joker kullanmayın)
ATLASSIAN_OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:5050/api/jira-oauth/callback
ATLASSIAN_OAUTH_ALLOWED_GRANT_TYPES=authorization_code,refresh_token
ATLASSIAN_OAUTH_REQUIRE_CONSENT=true

# --- Onay ekranı (isteğe bağlı) ---
#MCP_CONSENT_ORG=QNB Sigorta
#MCP_CONSENT_LOGO_FILE=C:\mcp\logo.png
#MCP_CONSENT_SUPPORT=Hayat Yazılım Geliştirme
#MCP_CONSENT_PAGE=fastmcp

# --- Etki alanı ---
READ_ONLY_MODE=true
MCP_ALLOWED_URL_DOMAINS=cfehjiratest.cignafinans.com.tr

# --- HTTP ---
TRANSPORT=streamable-http
HOST=127.0.0.1
PORT=9000
