# MCP Inspector ile yerel deneme — OAuth YOK, kendi Jira kişisel tokenınla.
# local.env adıyla kopyalayıp doldurun (local.env repoya konmaz).
# Çalıştırma: Inspectorda Command = C:\jiramcp\mcp.bat, Arguments = --env-file C:\jiramcp\local.env
JIRA_URL=https://cfehjiratest.cignafinans.com.tr
# Jira → Profil → Kişisel Erişim Tokenları → Token oluştur
JIRA_PERSONAL_TOKEN=
READ_ONLY_MODE=true
# ATLASSIAN_OAUTH_* satırlarını EKLEMEYİN: eklenirse OAuth vekili açılır.
